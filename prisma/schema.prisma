generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EDITOR
  ADVERTISER
  VISITOR
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum BusinessCategory {
  RESTAURANT
  LAW
  REAL_ESTATE
  HEALTH
  SERVICES
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdPlacement {
  SIDEBAR
  IN_ARTICLE
  FOOTER
  HOME_STRIP
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  username         String   @unique
  passwordHash     String?
  googleId         String?  @unique
  imageUrl         String?
  description      String?
  profileCompleted Boolean  @default(false)
  heardAbout       String?
  role             Role
  createdAt        DateTime @default(now())

  publications      Publication[]
  refreshTokens     RefreshToken[]
  pendingUploads    PendingUpload[]
  publicationViews  PublicationView[]
  reactions         PublicationReaction[]
  comments          Comment[]
  businessListings  BusinessListing[]
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("#8B1E1E")
  createdAt   DateTime @default(now())

  publications Publication[]
}

model Publication {
  id               String            @id @default(uuid())
  title            String
  slug             String            @unique
  body             String
  status           PublicationStatus @default(DRAFT)
  publishedAt      DateTime?
  scheduledAt      DateTime?
  featuredImageUrl String?
  views            Int               @default(0)
  likes            Int               @default(0)
  rankScore        Float             @default(0)
  tags             String[]          @default([])
  searchText       String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  authorId          String
  author            User                @relation(fields: [authorId], references: [id])
  categoryId        String
  category          Category            @relation(fields: [categoryId], references: [id])
  publicationViews  PublicationView[]
  reactions         PublicationReaction[]
  comments          Comment[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model PendingUpload {
  id        String   @id @default(uuid())
  url       String
  publicId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  familyId  String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model PublicationView {
  id            String      @id @default(uuid())
  userId        String
  publicationId String
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([userId, publicationId])
  @@index([publicationId])
}

model ListingView {
  id        String   @id @default(uuid())
  ip        String
  listingId String
  createdAt DateTime @default(now())

  @@unique([ip, listingId])
  @@index([listingId])
}

model PublicationReaction {
  id            String   @id @default(uuid())
  userId        String
  publicationId String
  type          String   @default("LIKE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([userId, publicationId])
  @@index([publicationId])
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      String   @default("PASSWORD_RESET")
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Comment {
  id            String   @id @default(uuid())
  body          String
  userId        String
  publicationId String
  parentId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  parent      Comment?    @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]   @relation("CommentReplies")

  @@index([publicationId, createdAt])
  @@index([parentId])
}

model BusinessListing {
  id            String           @id @default(uuid())
  businessName  String
  category      BusinessCategory
  description   String?
  phone         String
  email         String
  website       String?
  status        ListingStatus    @default(PENDING)
  submittedAt   DateTime         @default(now())
  reviewedAt    DateTime?
  views         Int              @default(0)
  phoneClicks   Int              @default(0)
  emailClicks   Int              @default(0)
  websiteClicks Int              @default(0)
  searchText    String           @default("")
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([status, category])
  @@index([createdById])
}

model Advertisement {
  id              String      @id @default(uuid())
  title           String
  imageUrl        String
  linkUrl         String
  placement       AdPlacement
  advertiserName  String?
  advertiserEmail String?
  startDate       DateTime
  endDate         DateTime
  impressions     Int         @default(0)
  clicks          Int         @default(0)
  maxImpressions  Int?
  createdAt       DateTime    @default(now())

  @@index([placement, startDate])
}

model AdImpression {
  id              String   @id @default(uuid())
  ip              String
  advertisementId String
  createdAt       DateTime @default(now())

  @@unique([ip, advertisementId])
  @@index([advertisementId])
}

model AdClick {
  id              String   @id @default(uuid())
  ip              String
  advertisementId String
  createdAt       DateTime @default(now())

  @@unique([ip, advertisementId])
  @@index([advertisementId])
}

model AdLog {
  id              String   @id @default(uuid())
  adminName       String
  adminEmail      String
  action          String
  adTitle         String
  advertisementId String?
  changes         Json?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([advertisementId])
}

model NewsletterSubscriber {
  id               String    @id @default(uuid())
  email            String    @unique
  unsubscribeToken String    @unique
  confirmedAt      DateTime?
  subscribedAt     DateTime  @default(now())
  deletedAt        DateTime?

  @@index([subscribedAt])
}
